{
  "asyncapi": "3.1.0",
  "info": {
    "title": "GameAPI WebSocket Contract",
    "version": "2.2.0",
    "description": "Real-time contract for Tic-Tac-Toe gameplay, user presence, and the global in-memory chat. The three channels share a common envelope {event, payload}; the gameplay channel also carries the invitation lifecycle events retry_invitation, invitation_replaced, invitation_promoted, and invitation_retry_accepted.",
    "contact": {
      "name": "The Three Musketeers",
      "url": "https://gitlab.com/jala-university1/cohort-5/ES.CO.CSNT-245.GA.T2.26.M2/SD/capstone/the-three-musketeers"
    },
    "license": {
      "name": "GPL-3.0",
      "url": "https://www.gnu.org/licenses/gpl-3.0"
    }
  },
  "servers": {
    "development": {
      "host": "localhost:8080",
      "pathname": "/api/v2/ws",
      "protocol": "ws",
      "description": "Local development server (Vite proxy or direct Uvicorn)."
    },
    "production": {
      "host": "gameapi-9vos.onrender.com",
      "pathname": "/api/v2/ws",
      "protocol": "wss",
      "description": "Production deployment on Render. TLS provided by the platform. Free tier: the service sleeps after 15 minutes of inactivity; the first request after a cold start may take 30-60 seconds."
    }
  },
  "channels": {
    "gameplays": {
      "address": "/gameplays",
      "title": "Gameplays channel",
      "description": "Real-time gameplay events: invitations, moves, turn changes, game endings.",
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "messages": {
        "auth": {
          "$ref": "#/components/messages/auth"
        },
        "ping": {
          "$ref": "#/components/messages/ping"
        },
        "create_game": {
          "$ref": "#/components/messages/create_game"
        },
        "accept_invitation": {
          "$ref": "#/components/messages/accept_invitation"
        },
        "reject_invitation": {
          "$ref": "#/components/messages/reject_invitation"
        },
        "play_move": {
          "$ref": "#/components/messages/play_move"
        },
        "leave_game": {
          "$ref": "#/components/messages/leave_game"
        },
        "subscribe_game": {
          "$ref": "#/components/messages/subscribe_game"
        },
        "unsubscribe_game": {
          "$ref": "#/components/messages/unsubscribe_game"
        },
        "auth_ok": {
          "$ref": "#/components/messages/auth_ok"
        },
        "auth_error": {
          "$ref": "#/components/messages/auth_error"
        },
        "pong": {
          "$ref": "#/components/messages/pong"
        },
        "game_created": {
          "$ref": "#/components/messages/game_created"
        },
        "invitation_received": {
          "$ref": "#/components/messages/invitation_received"
        },
        "invitation_accepted": {
          "$ref": "#/components/messages/invitation_accepted"
        },
        "invitation_rejected": {
          "$ref": "#/components/messages/invitation_rejected"
        },
        "board_updated": {
          "$ref": "#/components/messages/board_updated"
        },
        "game_ended": {
          "$ref": "#/components/messages/game_ended"
        },
        "subscribed": {
          "$ref": "#/components/messages/subscribed"
        },
        "unsubscribed": {
          "$ref": "#/components/messages/unsubscribed"
        },
        "error": {
          "$ref": "#/components/messages/error"
        },
        "invitation_queued": {
          "$ref": "#/components/messages/invitation_queued"
        },
        "invitation_expired": {
          "$ref": "#/components/messages/invitation_expired"
        },
        "invitation_canceled": {
          "$ref": "#/components/messages/invitation_canceled"
        },
        "retry_invitation": {
          "$ref": "#/components/messages/retry_invitation"
        },
        "invitation_replaced": {
          "$ref": "#/components/messages/invitation_replaced"
        },
        "invitation_promoted": {
          "$ref": "#/components/messages/invitation_promoted"
        },
        "invitation_retry_accepted": {
          "$ref": "#/components/messages/invitation_retry_accepted"
        }
      }
    },
    "presence": {
      "address": "/presence",
      "title": "Presence channel",
      "description": "Real-time user presence: online users, joins, and leaves.",
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "messages": {
        "auth": {
          "$ref": "#/components/messages/auth"
        },
        "ping": {
          "$ref": "#/components/messages/ping"
        },
        "list_online_users": {
          "$ref": "#/components/messages/list_online_users"
        },
        "auth_ok": {
          "$ref": "#/components/messages/auth_ok"
        },
        "auth_error": {
          "$ref": "#/components/messages/auth_error"
        },
        "pong": {
          "$ref": "#/components/messages/pong"
        },
        "online_users": {
          "$ref": "#/components/messages/online_users"
        },
        "user_status": {
          "$ref": "#/components/messages/user_status"
        },
        "user_online": {
          "$ref": "#/components/messages/user_online"
        },
        "user_offline": {
          "$ref": "#/components/messages/user_offline"
        },
        "user_updated": {
          "$ref": "#/components/messages/user_updated"
        },
        "error": {
          "$ref": "#/components/messages/error"
        }
      }
    },
    "chat": {
      "address": "/chat",
      "title": "Global chat channel",
      "description": "Authenticated, single-room, in-memory global chat. History is not persisted; the buffer is lost on process restart. Rate-limited per user.",
      "bindings": {
        "ws": {
          "method": "GET"
        }
      },
      "messages": {
        "auth": {
          "$ref": "#/components/messages/auth"
        },
        "ping": {
          "$ref": "#/components/messages/ping"
        },
        "chat_send": {
          "$ref": "#/components/messages/chat_send"
        },
        "auth_ok": {
          "$ref": "#/components/messages/auth_ok"
        },
        "auth_error": {
          "$ref": "#/components/messages/auth_error"
        },
        "pong": {
          "$ref": "#/components/messages/pong"
        },
        "chat_history": {
          "$ref": "#/components/messages/chat_history"
        },
        "chat_message": {
          "$ref": "#/components/messages/chat_message"
        },
        "chat_users_count": {
          "$ref": "#/components/messages/chat_users_count"
        },
        "chat_error": {
          "$ref": "#/components/messages/chat_error"
        }
      }
    }
  },
  "operations": {
    "receiveGameplayClientMessages": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/gameplays"
      },
      "title": "Client to server (gameplays)",
      "summary": "Messages sent by clients on the gameplays channel.",
      "messages": [
        {
          "$ref": "#/channels/gameplays/messages/auth"
        },
        {
          "$ref": "#/channels/gameplays/messages/ping"
        },
        {
          "$ref": "#/channels/gameplays/messages/create_game"
        },
        {
          "$ref": "#/channels/gameplays/messages/accept_invitation"
        },
        {
          "$ref": "#/channels/gameplays/messages/reject_invitation"
        },
        {
          "$ref": "#/channels/gameplays/messages/play_move"
        },
        {
          "$ref": "#/channels/gameplays/messages/retry_invitation"
        },
        {
          "$ref": "#/channels/gameplays/messages/leave_game"
        },
        {
          "$ref": "#/channels/gameplays/messages/subscribe_game"
        },
        {
          "$ref": "#/channels/gameplays/messages/unsubscribe_game"
        }
      ]
    },
    "sendGameplayServerMessages": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/gameplays"
      },
      "title": "Server to clients (gameplays)",
      "summary": "Messages pushed by the server on the gameplays channel.",
      "messages": [
        {
          "$ref": "#/channels/gameplays/messages/auth_ok"
        },
        {
          "$ref": "#/channels/gameplays/messages/auth_error"
        },
        {
          "$ref": "#/channels/gameplays/messages/pong"
        },
        {
          "$ref": "#/channels/gameplays/messages/game_created"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_received"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_accepted"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_canceled"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_expired"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_queued"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_rejected"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_replaced"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_promoted"
        },
        {
          "$ref": "#/channels/gameplays/messages/invitation_retry_accepted"
        },
        {
          "$ref": "#/channels/gameplays/messages/board_updated"
        },
        {
          "$ref": "#/channels/gameplays/messages/game_ended"
        },
        {
          "$ref": "#/channels/gameplays/messages/subscribed"
        },
        {
          "$ref": "#/channels/gameplays/messages/unsubscribed"
        },
        {
          "$ref": "#/channels/gameplays/messages/error"
        }
      ]
    },
    "receivePresenceClientMessages": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/presence"
      },
      "title": "Client to server (presence)",
      "summary": "Messages sent by clients on the presence channel.",
      "messages": [
        {
          "$ref": "#/channels/presence/messages/auth"
        },
        {
          "$ref": "#/channels/presence/messages/ping"
        },
        {
          "$ref": "#/channels/presence/messages/list_online_users"
        }
      ]
    },
    "sendPresenceServerMessages": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/presence"
      },
      "title": "Server to clients (presence)",
      "summary": "Messages pushed by the server on the presence channel.",
      "messages": [
        {
          "$ref": "#/channels/presence/messages/auth_ok"
        },
        {
          "$ref": "#/channels/presence/messages/auth_error"
        },
        {
          "$ref": "#/channels/presence/messages/pong"
        },
        {
          "$ref": "#/channels/presence/messages/online_users"
        },
        {
          "$ref": "#/channels/presence/messages/user_status"
        },
        {
          "$ref": "#/channels/presence/messages/user_online"
        },
        {
          "$ref": "#/channels/presence/messages/user_offline"
        },
        {
          "$ref": "#/channels/presence/messages/user_updated"
        },
        {
          "$ref": "#/channels/presence/messages/error"
        }
      ]
    },
    "receiveChatClientMessages": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/chat"
      },
      "title": "Client to server (chat)",
      "summary": "Messages sent by clients on the chat channel.",
      "messages": [
        {
          "$ref": "#/channels/chat/messages/auth"
        },
        {
          "$ref": "#/channels/chat/messages/ping"
        },
        {
          "$ref": "#/channels/chat/messages/chat_send"
        }
      ]
    },
    "sendChatServerMessages": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/chat"
      },
      "title": "Server to clients (chat)",
      "summary": "Messages pushed by the server on the chat channel.",
      "messages": [
        {
          "$ref": "#/channels/chat/messages/auth_ok"
        },
        {
          "$ref": "#/channels/chat/messages/auth_error"
        },
        {
          "$ref": "#/channels/chat/messages/pong"
        },
        {
          "$ref": "#/channels/chat/messages/chat_history"
        },
        {
          "$ref": "#/channels/chat/messages/chat_message"
        },
        {
          "$ref": "#/channels/chat/messages/chat_users_count"
        },
        {
          "$ref": "#/channels/chat/messages/chat_error"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "auth": {
        "name": "auth",
        "title": "Authentication",
        "summary": "Must be the first message after the WebSocket handshake.",
        "payload": {
          "$ref": "#/components/schemas/AuthPayload"
        }
      },
      "ping": {
        "name": "ping",
        "title": "Ping",
        "summary": "Keepalive. Recommended every 30 seconds.",
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "create_game": {
        "name": "create_game",
        "title": "Create game",
        "summary": "Host invites another user to a new game.",
        "payload": {
          "$ref": "#/components/schemas/CreateGamePayload"
        }
      },
      "accept_invitation": {
        "name": "accept_invitation",
        "title": "Accept invitation",
        "summary": "Accept a pending invitation to join a gameplay.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "reject_invitation": {
        "name": "reject_invitation",
        "title": "Reject invitation",
        "summary": "Reject a pending invitation to join a gameplay.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "play_move": {
        "name": "play_move",
        "title": "Play move",
        "summary": "Submit a move on the board. Only the player whose turn it is can move.",
        "payload": {
          "$ref": "#/components/schemas/PlayMovePayload"
        }
      },
      "leave_game": {
        "name": "leave_game",
        "title": "Leave game",
        "summary": "Abandon an active game. The opponent wins.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "subscribe_game": {
        "name": "subscribe_game",
        "title": "Subscribe to game",
        "summary": "Subscribe this socket to a game's event stream. A socket can only be subscribed to one game at a time.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "unsubscribe_game": {
        "name": "unsubscribe_game",
        "title": "Unsubscribe from game",
        "summary": "Remove this socket from the active game's channel subscription.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "list_online_users": {
        "name": "list_online_users",
        "title": "List online users",
        "summary": "Request the current set of online user IDs.",
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "auth_ok": {
        "name": "auth_ok",
        "title": "Auth success",
        "summary": "Sent immediately after a valid JWT is accepted.",
        "payload": {
          "$ref": "#/components/schemas/AuthOkPayload"
        }
      },
      "auth_error": {
        "name": "auth_error",
        "title": "Auth failure",
        "summary": "Sent before the socket is closed with code 4401 (invalid token) or 4408 (timeout).",
        "payload": {
          "$ref": "#/components/schemas/AuthErrorPayload"
        }
      },
      "pong": {
        "name": "pong",
        "title": "Pong",
        "summary": "Reply to a ping event.",
        "payload": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "game_created": {
        "name": "game_created",
        "title": "Game created",
        "summary": "The hosted game has been created and the guest was invited.",
        "payload": {
          "$ref": "#/components/schemas/GameCreatedPayload"
        }
      },
      "invitation_received": {
        "name": "invitation_received",
        "title": "Invitation received",
        "summary": "A host invites this user to a new game.",
        "payload": {
          "$ref": "#/components/schemas/InvitationReceivedPayload"
        }
      },
      "invitation_accepted": {
        "name": "invitation_accepted",
        "title": "Invitation accepted",
        "summary": "A pending invitation was accepted and the board is now active.",
        "payload": {
          "$ref": "#/components/schemas/InvitationAcceptedPayload"
        }
      },
      "invitation_rejected": {
        "name": "invitation_rejected",
        "title": "Invitation rejected",
        "summary": "A pending invitation was rejected by the guest.",
        "payload": {
          "$ref": "#/components/schemas/InvitationRejectedPayload"
        }
      },
      "board_updated": {
        "name": "board_updated",
        "title": "Board updated",
        "summary": "The board was advanced after a valid move.",
        "payload": {
          "$ref": "#/components/schemas/BoardUpdatedPayload"
        }
      },
      "game_ended": {
        "name": "game_ended",
        "title": "Game ended",
        "summary": "The gameplay ended. The payload contains the final board and the winning line when applicable.",
        "payload": {
          "$ref": "#/components/schemas/GameEndedPayload"
        }
      },
      "subscribed": {
        "name": "subscribed",
        "title": "Subscribed",
        "summary": "The socket was subscribed to a specific game stream.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "unsubscribed": {
        "name": "unsubscribed",
        "title": "Unsubscribed",
        "summary": "The socket was removed from the active game stream.",
        "payload": {
          "$ref": "#/components/schemas/GameIdPayload"
        }
      },
      "online_users": {
        "name": "online_users",
        "title": "Online users list",
        "summary": "Current online users for the presence channel, including the derived playing subset.",
        "payload": {
          "$ref": "#/components/schemas/OnlineUsersPayload"
        }
      },
      "user_status": {
        "name": "user_status",
        "title": "User status changed",
        "summary": "Broadcast emitted when a user transitions between available and playing state.",
        "payload": {
          "$ref": "#/components/schemas/UserStatusPayload"
        }
      },
      "user_online": {
        "name": "user_online",
        "title": "User came online",
        "summary": "Another user joined the presence channel.",
        "payload": {
          "$ref": "#/components/schemas/UserIdPayload"
        }
      },
      "user_offline": {
        "name": "user_offline",
        "title": "User went offline",
        "summary": "Another user disconnected from the presence channel.",
        "payload": {
          "$ref": "#/components/schemas/UserIdPayload"
        }
      },
      "user_updated": {
        "name": "user_updated",
        "title": "User profile updated",
        "summary": "Broadcast emitted when a user changes their public name. Clients should reload the public user data.",
        "payload": {
          "$ref": "#/components/schemas/UserIdPayload"
        }
      },
      "error": {
        "name": "error",
        "title": "Error",
        "summary": "Generic error message for invalid event, invalid payload, or domain logic failures.",
        "payload": {
          "$ref": "#/components/schemas/ErrorPayload"
        }
      },
      "invitation_queued": {
        "name": "invitation_queued",
        "title": "Invitation queued",
        "summary": "A guest already has an active or waiting invitation, so the next request is queued.",
        "payload": {
          "$ref": "#/components/schemas/InvitationQueuedPayload"
        }
      },
      "invitation_expired": {
        "name": "invitation_expired",
        "title": "Invitation expired",
        "summary": "A pending or queued invitation exceeded the TTL and was expired.",
        "payload": {
          "$ref": "#/components/schemas/InvitationExpiredPayload"
        }
      },
      "invitation_canceled": {
        "name": "invitation_canceled",
        "title": "Invitation canceled",
        "summary": "A pending invitation was canceled because the host or guest left.",
        "payload": {
          "$ref": "#/components/schemas/InvitationCanceledPayload"
        }
      },
      "chat_send": {
        "name": "chat_send",
        "title": "Send message",
        "summary": "Send a message to the global chat. Rate-limited per user (10 messages per 10 seconds, 30-second block on excess).",
        "payload": {
          "$ref": "#/components/schemas/ChatSendPayload"
        }
      },
      "chat_history": {
        "name": "chat_history",
        "title": "Chat history",
        "summary": "Sent to a newly connected client immediately after auth_ok. Contains the recent messages and the current user count.",
        "payload": {
          "$ref": "#/components/schemas/ChatHistoryPayload"
        }
      },
      "chat_message": {
        "name": "chat_message",
        "title": "Chat message",
        "summary": "Broadcast to every connected client when a message is accepted. The sender also receives it.",
        "payload": {
          "$ref": "#/components/schemas/ChatMessagePayload"
        }
      },
      "chat_users_count": {
        "name": "chat_users_count",
        "title": "Chat users count",
        "summary": "Broadcast when a client connects or disconnects. Excludes the client whose connection changed the count.",
        "payload": {
          "$ref": "#/components/schemas/ChatUsersCountPayload"
        }
      },
      "chat_error": {
        "name": "chat_error",
        "title": "Chat error",
        "summary": "Scoped error for the chat channel. The generic error event is not emitted on this channel.",
        "payload": {
          "$ref": "#/components/schemas/ChatErrorPayload"
        }
      },
      "retry_invitation": {
        "name": "retry_invitation",
        "title": "Retry invitation",
        "summary": "Reuse an existing gameplay whose invitation is in a terminal-but-recoverable state (rejected, expired, or canceled). Resets the board and re-emits invitation_received to the guest. Rate-limited per (host, guest) pair.",
        "payload": {
          "$ref": "#/components/schemas/RetryInvitationPayload"
        }
      },
      "invitation_replaced": {
        "name": "invitation_replaced",
        "title": "Invitation replaced",
        "summary": "The host's pending invitation was displaced because the guest accepted a different invitation from another host. Distinct from invitation_expired, which fires on TTL.",
        "payload": {
          "$ref": "#/components/schemas/InvitationReplacedPayload"
        }
      },
      "invitation_promoted": {
        "name": "invitation_promoted",
        "title": "Invitation promoted",
        "summary": "A queued invitation was promoted to pending because the preceding invitation was rejected, expired, or replaced. Payload shape matches invitation_received.",
        "payload": {
          "$ref": "#/components/schemas/InvitationPromotedPayload"
        }
      },
      "invitation_retry_accepted": {
        "name": "invitation_retry_accepted",
        "title": "Invitation retry accepted",
        "summary": "Acknowledgment sent to the host after a retry_invitation event. Includes the attempt number, remaining attempts in the window, and whether the call was a no-op.",
        "payload": {
          "$ref": "#/components/schemas/InvitationRetryAcceptedPayload"
        }
      }
    },
    "schemas": {
      "AuthPayload": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT access token used to authenticate the websocket connection."
          }
        }
      },
      "AuthOkPayload": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "Authenticated user identifier from the JWT subject claim."
          }
        }
      },
      "AuthErrorPayload": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "invalid_token",
              "expired_token",
              "auth_timeout",
              "expected_auth_event"
            ],
            "description": "Reason the websocket authentication failed."
          }
        }
      },
      "CreateGamePayload": {
        "type": "object",
        "required": [
          "guest_id"
        ],
        "properties": {
          "guest_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the opponent invited to the new game."
          }
        }
      },
      "GameIdPayload": {
        "type": "object",
        "required": [
          "game_id"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the gameplay being accessed."
          }
        }
      },
      "PlayMovePayload": {
        "type": "object",
        "required": [
          "game_id",
          "row",
          "col"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier on which the move is being played."
          },
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Board row index, zero-based, from 0 to 2."
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Board column index, zero-based, from 0 to 2."
          }
        }
      },
      "UserIdPayload": {
        "type": "object",
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "User identifier that came online or went offline."
          }
        }
      },
      "Board": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          }
        },
        "description": "3x3 board representing the current game state. 0 = empty, 1 = host, 2 = guest."
      },
      "LastMove": {
        "type": "object",
        "required": [
          "row",
          "col",
          "player"
        ],
        "properties": {
          "row": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Row index of the last move."
          },
          "col": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Column index of the last move."
          },
          "player": {
            "type": "string",
            "enum": [
              "host",
              "guest"
            ],
            "description": "Player who made the last move."
          }
        }
      },
      "GameCreatedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "guest_id",
          "board",
          "turn"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the newly created game."
          },
          "guest_id": {
            "type": "string",
            "format": "uuid",
            "description": "Opponent invited to the new game."
          },
          "board": {
            "$ref": "#/components/schemas/Board",
            "description": "Initial empty board state after the game is created."
          },
          "turn": {
            "type": "string",
            "format": "uuid",
            "description": "User ID whose turn it currently is; for a new game this is the host."
          }
        }
      },
      "InvitationReceivedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "host"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Game identifier for the invitation being received."
          },
          "host": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "description": "User ID of the host who sent the invitation."
              },
              "name": {
                "type": "string",
                "description": "Display name of the host who sent the invitation."
              }
            },
            "description": "Host metadata for the invitation."
          }
        }
      },
      "InvitationAcceptedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "board",
          "turn"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier that became active after the invitation was accepted."
          },
          "board": {
            "$ref": "#/components/schemas/Board",
            "description": "Board state of the game after the invitation is accepted."
          },
          "turn": {
            "type": "string",
            "format": "uuid",
            "description": "User ID whose turn it is now; the host moves first."
          }
        }
      },
      "InvitationRejectedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "guest_id"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier of the invitation that was rejected."
          },
          "guest_id": {
            "type": "string",
            "format": "uuid",
            "description": "User ID of the guest who rejected the invitation."
          }
        }
      },
      "BoardUpdatedPayload": {
        "type": "object",
        "required": [
          "board",
          "turn",
          "last_move"
        ],
        "properties": {
          "board": {
            "$ref": "#/components/schemas/Board",
            "description": "Updated board state after the move."
          },
          "turn": {
            "type": "string",
            "format": "uuid",
            "description": "User ID whose turn is next after the move."
          },
          "last_move": {
            "$ref": "#/components/schemas/LastMove",
            "description": "Position and player for the last move that changed the board."
          }
        }
      },
      "GameEndedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "board",
          "winner",
          "reason"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the finished gameplay."
          },
          "board": {
            "$ref": "#/components/schemas/Board",
            "description": "Final board state after the game ended. When the reason is abandon or rejected, this still reflects the current board state known by the server."
          },
          "winner": {
            "oneOf": [
              {
                "type": "string",
                "format": "uuid",
                "description": "User ID of the winner of the gameplay."
              },
              {
                "type": "null",
                "description": "No winner; this was a draw."
              }
            ],
            "description": "Winner user ID or null in draw scenarios."
          },
          "reason": {
            "type": "string",
            "enum": [
              "line",
              "draw",
              "abandon",
              "rejected"
            ],
            "description": "Why the game ended: line, draw, abandon, or rejected invitation."
          },
          "winner_line": {
            "type": [
              "array",
              "null"
            ],
            "description": "Three coordinates in row/column format for the winning line, or null when no line exists.",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      },
      "OnlineUsersPayload": {
        "type": "object",
        "required": [
          "users",
          "playing"
        ],
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of an online user."
            },
            "description": "List of online user identifiers."
          },
          "playing": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "description": "Identifier of an online user who is currently in an accepted active game."
            },
            "description": "Derived subset of online users whose authoritative gameplay state is accepted and active in the database."
          }
        }
      },
      "UserStatusPayload": {
        "type": "object",
        "required": [
          "user_id",
          "status"
        ],
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "User identifier whose status changed."
          },
          "status": {
            "type": "string",
            "enum": [
              "playing",
              "available"
            ],
            "description": "Derived availability state for the user. 'playing' means an accepted active game exists; 'available' means they are no longer in active gameplay."
          }
        }
      },
      "ErrorPayload": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_EVENT",
              "INVALID_PAYLOAD",
              "NOT_IMPLEMENTED",
              "NOT_YOUR_TURN",
              "INVALID_MOVE",
              "GAME_NOT_FOUND",
              "GAME_NOT_ACTIVE",
              "NOT_A_PARTICIPANT",
              "INVITATION_NOT_PENDING",
              "CANNOT_INVITE_SELF",
              "OPPONENT_OFFLINE",
              "UNKNOWN_ERROR",
              "HOST_BUSY",
              "USER_BUSY",
              "RETRY_LIMIT_EXCEEDED",
              "CREATE_GAME_RATE_LIMITED"
            ],
            "description": "Machine-readable error code for the problem."
          },
          "message": {
            "type": "string",
            "description": "Human-readable description of the error."
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Only present when the error is rate-limited (RETRY_LIMIT_EXCEEDED or CREATE_GAME_RATE_LIMITED). Number of seconds the client must wait before retrying."
          }
        }
      },
      "InvitationQueuedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "reason"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier waiting behind the current queue."
          },
          "reason": {
            "type": "string",
            "enum": [
              "target_busy",
              "host_busy"
            ],
            "description": "Why the invitation was queued."
          }
        }
      },
      "InvitationExpiredPayload": {
        "type": "object",
        "required": [
          "game_id",
          "reason"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier that expired."
          },
          "reason": {
            "type": "string",
            "enum": [
              "timeout",
              "target_busy"
            ],
            "description": "Expiration reason."
          }
        }
      },
      "InvitationCanceledPayload": {
        "type": "object",
        "required": [
          "game_id",
          "reason"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid",
            "description": "Gameplay identifier that was canceled."
          },
          "reason": {
            "type": "string",
            "enum": [
              "host_left",
              "guest_left"
            ],
            "description": "Why the invitation was canceled."
          }
        }
      },
      "ChatSendPayload": {
        "type": "object",
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Plain-text message. Sanitized server-side; bidi and zero-width control characters are stripped and whitespace is collapsed."
          }
        }
      },
      "ChatMessagePayload": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "user_name",
          "content",
          "timestamp"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique message identifier."
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the user who sent the message."
          },
          "user_name": {
            "type": "string",
            "description": "Sanitized username used for display in the chat."
          },
          "content": {
            "type": "string",
            "description": "Sanitized message text."
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp when the message was published."
          }
        }
      },
      "ChatHistoryPayload": {
        "type": "object",
        "required": [
          "messages",
          "users_count"
        ],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatMessagePayload"
            },
            "description": "Recent chat messages in reverse chronological order, capped by the server history window."
          },
          "users_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Current number of authenticated users connected to the global chat channel."
          }
        }
      },
      "ChatUsersCountPayload": {
        "type": "object",
        "required": [
          "count"
        ],
        "properties": {
          "count": {
            "type": "integer",
            "minimum": 0,
            "description": "Current number of connected chat users after the join/leave event."
          }
        }
      },
      "ChatErrorPayload": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "INVALID_EVENT",
              "INVALID_PAYLOAD",
              "NOT_IMPLEMENTED",
              "CHAT_MESSAGE_EMPTY",
              "CHAT_MESSAGE_TOO_LONG",
              "CHAT_RATE_LIMITED"
            ],
            "description": "Machine-readable reason for the chat-specific validation or rate-limit failure."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation of the problem."
          },
          "retry_after_seconds": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of seconds the client must wait before sending another chat message after a rate-limit block."
          }
        }
      },
      "RetryInvitationPayload": {
        "type": "object",
        "required": [
          "game_id"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "InvitationReplacedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "reason"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "enum": [
              "target_busy"
            ],
            "description": "The guest accepted a different invitation."
          }
        }
      },
      "InvitationPromotedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "host"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          },
          "host": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "InvitationRetryAcceptedPayload": {
        "type": "object",
        "required": [
          "game_id",
          "attempt",
          "remaining_attempts",
          "idempotent"
        ],
        "properties": {
          "game_id": {
            "type": "string",
            "format": "uuid"
          },
          "attempt": {
            "type": "integer",
            "minimum": 0
          },
          "remaining_attempts": {
            "type": "integer",
            "minimum": 0
          },
          "idempotent": {
            "type": "boolean",
            "description": "True when the gameplay was already pending and no server-side state changed."
          }
        }
      }
    }
  }
}
