# =============================================================================
# Observability stack — local development only.
#
# Copy this file to `.env.monitoring` and fill in the values below.
# The real `.env.monitoring` file is gitignored and must never be committed.
#
# This stack is NOT deployed to Render. It only runs on the developer machine.
# =============================================================================

# --- Grafana ---------------------------------------------------------------
# Admin credentials for the local Grafana instance.
# Bind is intentionally restricted to 127.0.0.1 in the overlay compose file.
# Generate a strong password with: openssl rand -base64 24
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-running

# --- Prometheus ------------------------------------------------------------
# Retention window for the time-series database. 7 days keeps the on-disk
# footprint around 300-500 MB for a local demo.
PROMETHEUS_RETENTION=7d

# Scrape interval shared by most jobs. The API metrics endpoint is cheap to
# scrape, so 15s is a reasonable default for a laptop.
PROMETHEUS_SCRAPE_INTERVAL=15s

# --- Blackbox exporter -----------------------------------------------------
# URL that blackbox probes to determine API liveness. Defaults to the health
# endpoint on the API service, resolved through the monitoring network.
BLACKBOX_API_HEALTH_URL=http://api:8080/health
