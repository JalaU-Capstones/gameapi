# WARNING: Do not commit your real .env file.
# For production, generate secrets with: openssl rand -base64 48

# PostgreSQL
# Accepts postgres://, postgresql://, or postgresql+asyncpg://.
# The app normalizes the URI to postgresql+asyncpg:// at startup.
POSTGRES_URI=postgresql+asyncpg://gameapi:gameapi@localhost:5432/gameapi
POSTGRES_USER=gameapi
POSTGRES_PASSWORD=gameapi
POSTGRES_DB=gameapi
POSTGRES_PORT=5432

# JWT
JWT_SECRET_KEY=Una_Clave_Secreta_Super_Segura_con_Minimo_32_Caracteres_123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=GameAPI
JWT_AUDIENCE=GameAPI
JWT_EXPIRE_MINUTES=60

# Auth
AUTH_ACCESS_COOKIE_NAME=gameapi_at
AUTH_REFRESH_COOKIE_NAME=gameapi_rt
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/v2/auth
AUTH_ACCESS_COOKIE_PATH=/

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# IMPORTANT: if you set a specific origin list here, cookies will work cross-origin.
# If you keep "*", browsers will not send cookies for cross-site requests.
CORS_ORIGINS=*

# Persistent logging
LOG_BUFFER_SIZE=100
LOG_FLUSH_INTERVAL_SECONDS=5.0
LOG_RETENTION_DAYS=30
LOG_QUEUE_MAXSIZE=1000
# Comma-separated email addresses allowed to query all logs.
LOG_ADMIN_EMAILS=admin@gameapi.local

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_ANONYMOUS_DEFAULT=60/minute
RATE_LIMIT_AUTHENTICATED_DEFAULT=60/minute
RATE_LIMIT_AUTH_ME=60/minute
RATE_LIMIT_LOGS_ME=30/minute
RATE_LIMIT_LOGS_ADMIN=300/minute
RATE_LIMIT_WS_HANDSHAKE=10/minute
