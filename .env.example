# Docker Compose runs in local only. Postgres is not exposed to the host by design;
# use `docker compose exec postgres psql -U gameapi -d gameapi` to inspect it.
# In production (Render), the database is managed externally and this file is not used.
# WARNING: Do not commit your real .env file.
# For production, generate secrets with: openssl rand -base64 48

# PostgreSQL
# Accepts postgres://, postgresql://, or postgresql+asyncpg://.
# The app normalizes the URI to postgresql+asyncpg:// at startup.
POSTGRES_URI=postgresql+asyncpg://gameapi:gameapi@localhost:5432/gameapi
POSTGRES_USER=gameapi
POSTGRES_PASSWORD=gameapi
POSTGRES_DB=gameapi
# Password for the runtime Postgres role `gameapi_app`. Only used when the
# Postgres container initializes a fresh volume. To regenerate, run
# `docker compose down -v && docker compose up -d` after updating this value.
GAMEAPI_APP_PASSWORD=gameapi_app_dev

# JWT
JWT_SECRET_KEY=Una_Clave_Secreta_Super_Segura_con_Minimo_32_Caracteres_123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=GameAPI
JWT_AUDIENCE=GameAPI
JWT_EXPIRE_MINUTES=60

# Auth
AUTH_ACCESS_COOKIE_NAME=gameapi_at
AUTH_REFRESH_COOKIE_NAME=gameapi_rt
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
# SameSite policy for auth cookies.
#   - 'lax'  — default for local development.
#   - 'none' — REQUIRED in production when the frontend and backend are on
#              different sites (e.g., two distinct *.onrender.com subdomains,
#              which the PSL treats as separate sites). Requires
#              AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
# Optional cookie domain. Leave EMPTY unless you intentionally want to share
# cookies with a parent domain you own. Do NOT set to '.onrender.com' — that
# domain is on the Public Suffix List and browsers will reject the cookie.
AUTH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/v2/auth
AUTH_ACCESS_COOKIE_PATH=/

# Invitaciones
INVITATION_PENDING_TTL_SECONDS=60
INVITATION_QUEUED_TTL_SECONDS=300
INVITATION_EXPIRY_INTERVAL_SECONDS=10.0
INVITATION_QUEUED_EXPIRY_INTERVAL_SECONDS=30.0
ABANDON_GRACE_SECONDS=5.0
INVITATION_PAIR_MAX_ATTEMPTS=3
INVITATION_PAIR_WINDOW_SECONDS=180

# Chat
CHAT_RATE_MAX_MESSAGES=10
CHAT_RATE_WINDOW_SECONDS=10.0
CHAT_RATE_BLOCK_SECONDS=30.0

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# IMPORTANT: if you set a specific origin list here, cookies will work cross-origin.
# If you keep "*", browsers will not send cookies for cross-site requests.
CORS_ORIGINS=*

# Persistent logging
LOG_BUFFER_SIZE=100
LOG_FLUSH_INTERVAL_SECONDS=5.0
LOG_RETENTION_DAYS=30
LOG_QUEUE_MAXSIZE=1000
# Comma-separated email addresses allowed to query all logs.
LOG_ADMIN_EMAILS=admin@gameapi.local

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
RATE_LIMIT_ANONYMOUS_DEFAULT=60/minute
RATE_LIMIT_AUTHENTICATED_DEFAULT=60/minute
RATE_LIMIT_AUTH_ME=60/minute
RATE_LIMIT_LOGS_ME=30/minute
RATE_LIMIT_LOGS_ADMIN=300/minute
RATE_LIMIT_CREATE_GAME=5/minute
RATE_LIMIT_WS_HANDSHAKE=10/minute
RATE_LIMIT_SESSION_TAKEOVER=3/minute

# Metrics
METRICS_ENABLED=false
