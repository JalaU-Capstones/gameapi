# PostgreSQL
POSTGRES_URI=postgresql+asyncpg://gameapi:gameapi@localhost:5432/gameapi
POSTGRES_USER=gameapi
POSTGRES_PASSWORD=gameapi
POSTGRES_DB=gameapi
POSTGRES_PORT=5432

# JWT
JWT_SECRET_KEY=Una_Clave_Secreta_Super_Segura_con_Minimo_32_Caracteres_123456789
JWT_ALGORITHM=HS256
JWT_ISSUER=GameAPI
JWT_AUDIENCE=GameAPI
JWT_EXPIRE_MINUTES=60

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
CORS_ORIGINS=*

# Persistent logging
LOG_BUFFER_SIZE=100
LOG_FLUSH_INTERVAL_SECONDS=5.0
LOG_RETENTION_DAYS=30
LOG_QUEUE_MAXSIZE=1000
# Comma-separated email addresses allowed to query all logs.
LOG_ADMIN_EMAILS=admin@gameapi.local
